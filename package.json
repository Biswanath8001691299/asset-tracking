{
  "name": "asset-tracker",
  "version": "1.0.0",
  "description": "Personal asset tracker for Indian stocks, crypto and gold SIP with live market prices and MongoDB storage",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node --watch src/server.js --memory",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "mongoose": "^9.12.2",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
